<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Requires a Developer Team with the Network Extension capability
	     and the App Group registered. Identifiers come from
	     Config/Signing.xcconfig. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- Access Wi-Fi Information: NEHotspotNetwork.fetchCurrent (Wi-Fi auto
	     profile) needs this as well as an active VPN; without it nehelper
	     denies the request. No location permission is involved. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(FLUXMOAT_APP_GROUP)</string>
	</array>
</dict>
</plist>
